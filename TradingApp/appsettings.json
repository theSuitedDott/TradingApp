{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=tradingapp;Username=postgres;Password=postgres"
  },
  "Oanda": {
    "ApiToken": "",
    "AccountId": "",
    "BaseUrl": "https://api-fxpractice.oanda.com",
    "LiveOrderEnabled": false,
    "DefaultLots": 0.01
  },
  "Finnhub": {
    "ApiKey": "",
    "BaseUrl": "https://finnhub.io/api/v1/"
  },
  "AlphaVantage": {
    "ApiKey": "",
    "BaseUrl": "https://www.alphavantage.co/"
  },
  "TwelveData": {
    "ApiKey": "",
    "BaseUrl": "https://api.twelvedata.com/"
  },
  "MarketDataFeed": {
    "Provider": "Finnhub",
    "AutoStart": true,
    "IntervalMs": 5000,
    "Symbols": [
      { "Symbol": "EUR_USD", "Exchange": "OANDA" },
      { "Symbol": "GBP_USD", "Exchange": "OANDA" }
    ]
  },
  "PaperTrading": {
    "CommissionRate": 0.001,
    "MinimumCommission": 1
  },
  "InstitutionalSetup": {
    "Enabled": true,
    "ScanIntervalSeconds": 60,
    "ExitScanIntervalSeconds": 60,
    "Symbol": "EUR_USD",
    "Exchange": "OANDA",
    "RsiPeriod": 3,
    "MaxOpportunities": 50,
    "UseLiveData": false
  },
  "Jwt": {
    "Secret": "OVERRIDE_IN_ENVIRONMENT_OR_USER_SECRETS_MIN_32_CHARS",
    "Issuer": "TradingApp",
    "Audience": "TradingApp.Api",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
